extends SceneTree
## Run with -- --check to detect drift without changing the working tree.
const Registry = preload("res://scripts/hull_admin_registry.gd")
const PATH := "res://docs/hull-admin-commands.md"

func _initialize() -> void:
	var doc := """# Local workshop command reference

Generated by `tools/hull_admin_reference.gd` from `scripts/hull_admin_registry.gd`.
See [the workshop guide](hull-workshop.md) for a complete walkthrough.

`[arguments]` are optional. Use Tab for the actual IDs in your current game or bank.
**Desk** works from any sandbox screen. **Expedition** requires an unfinished
run. **Combat** requires an active encounter. Wait for presentation to settle
before editing. Check **Recorded** to see which operations `scenario replay` repeats.

| Command | State | Recorded | Result |
| --- | --- | --- | --- |
"""
	for command in Registry.COMMANDS:
		var spec: Array = Registry.COMMANDS[command]
		doc += "| `%s` | %s | %s | %s |\n" % [Registry.usage(command),spec[1],"yes" if spec[2] else "no",spec[3]]
	doc += "\n## Sound Desk operations\n\nAudio operations change the active mixer and are independent of scenario replay.\n\n```text\n%s\n```\n" % Registry.audio_help()
	if "--check" in OS.get_cmdline_user_args():
		if not FileAccess.file_exists(PATH) or FileAccess.get_file_as_string(PATH) != doc:
			push_error("Regenerate " + PATH)
			quit(1)
			return
	else:
		var file := FileAccess.open(PATH,FileAccess.WRITE)
		if file == null:
			quit(1)
			return
		file.store_string(doc)
		file.close()
	print("Workshop registry reference: ", Registry.COMMANDS.size(), " commands; ", Registry.AUDIO.size()," audio operations.")
	quit(0)
