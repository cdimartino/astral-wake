extends SceneTree
const Hull = preload("res://scripts/hull_audio.gd")
const Defeat = preload("res://scripts/enemy_defeat_audio.gd")

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	var storage := OS.get_environment("ASTRAL_SAVE_DIR")
	assert(not storage.is_empty(), "Fresh isolated ASTRAL_SAVE_DIR required")
	var hull := Hull.new()
	root.add_child(hull)
	hull.initialize(storage)
	hull.set_process(false)
	var helper := Defeat.new()
	root.add_child(helper)
	helper.setup(hull)
	helper.set_process(false)
	helper.combat_preview.set_process(false)
	var bank: Dictionary = hull.bank.duplicate(true)
	var preset: Dictionary = hull.preset_snapshot()
	var master := AudioServer.get_bus_volume_db(0)
	hull.play_cue("score_reed_mist")
	var other: AudioStreamPlayer = hull.voices.back()
	helper.resolved_batch("none", 0, true)
	helper.resolved_batch("", 2, true)
	assert(hull.voices.size() == 1)
	helper.resolved_batch("one", 1)
	assert(helper.combat_preview.last_error.is_empty(), helper.combat_preview.last_error)
	assert(hull.voices.size() == 2)
	var kill: AudioStreamPlayer = hull.voices.back()
	assert(kill.get_meta("preview_event") == "kill" and kill.bus == "Combat")
	assert(is_equal_approx(kill.stream.get_length(), 0.38))
	assert(is_equal_approx(kill.volume_db, 0.0))
	helper.resolved_batch("one", 5, true)
	assert(hull.voices.size() == 2 and helper._clear_left < 0.0)
	helper.cancel()
	assert(hull.voices.size() == 1 and hull.voices.has(other))
	helper.resolved_batch("five", 5)
	assert(hull.voices.size() == 2, "Simultaneous five deaths play one retained kill")
	helper.cancel()
	hull._stinger = "guardian_2"
	hull._stinger_time = 1.25
	helper.resolved_batch("final", 1, true)
	helper._process(0.44)
	assert(hull.voices.size() == 2)
	helper._process(0.02)
	assert(hull.voices.size() == 3)
	var clear: AudioStreamPlayer = hull.voices.back()
	assert(clear.get_meta("preview_event") == "clear" and clear.bus == "Music")
	assert(is_equal_approx(clear.stream.get_length(), 1.70))
	assert(is_equal_approx(clear.volume_db, 0.0))
	assert(hull._stinger == "guardian_2" and hull._stinger_time == 1.25 and hull._seen.is_empty())
	hull.stingers_enabled = false
	helper.combat_preview._process(0.01)
	assert(not hull.voices.has(clear), "Live stinger-off stops only musical clear")
	assert(hull.voices.size() == 2 and hull.voices.has(other))
	helper.cancel()
	helper.resolved_batch("muted-clear", 1, true)
	assert(helper._clear_left < 0.0 and hull.voices.size() == 2)
	helper.cancel()
	hull.stingers_enabled = true
	hull._stinger = "victory"
	helper.resolved_batch("ending", 1, true)
	assert(helper._clear_left < 0.0)
	helper.cancel()
	hull._stinger = ""
	for target in ["combat_vent", "support/status"]:
		hull.muted[target] = true
		helper.resolved_batch("mute-" + target, 1)
		assert(hull.voices.size() == 1)
		hull.muted.clear()
	hull.solo = "vessel motif"
	helper.resolved_batch("track-solo", 1, true)
	assert(hull.voices.size() == 1)
	helper._process(0.46)
	assert(hull.voices.size() == 2 and hull.voices.back().get_meta("preview_event") == "clear")
	hull.muted["vessel motif"] = true
	helper.combat_preview._process(0.01)
	assert(hull.voices.size() == 1)
	helper.cancel()
	hull.solo = ""
	hull.muted.clear()
	hull.overrides["combat_vent"] = {"gain_db":-20.0, "pitch":0.5, "pan":0.25}
	helper.resolved_batch("mix", 1)
	kill = hull.voices.back()
	assert(is_equal_approx(kill.volume_db, -10.0) and is_equal_approx(kill.pitch_scale, 0.5))
	assert(kill.has_meta("private_bus"))
	helper.cancel()
	hull.overrides["combat_vent"] = {"patch":"combat_vent_hollow"}
	helper.resolved_batch("explicit-user-patch", 1)
	assert(hull.voices.back().get_meta("patch") == "combat_vent_hollow")
	helper.cancel()
	hull.overrides.clear()
	helper.resolved_batch("cancel", 1, true)
	helper.cancel()
	helper._process(2.0)
	assert(hull.voices.size() == 1)
	helper.resolved_batch("preview-off", 1, true)
	helper.combat_preview.set_enabled(false)
	helper._process(0.1)
	assert(helper._clear_left < 0.0 and hull.voices.size() == 1)
	helper.combat_preview.set_enabled(true)
	helper._process(1.0)
	assert(hull.voices.size() == 1, "Re-enable cannot play a stale clear")
	helper.resolved_batch("natural-finish", 1, true)
	helper.set_process(true)
	helper.combat_preview.set_process(true)
	await create_timer(2.5).timeout
	assert(helper.combat_preview._owned.is_empty() and helper._clear_left < 0.0)
	assert(hull.bank == bank and hull.preset_snapshot() == preset)
	assert(AudioServer.get_bus_volume_db(0) == master)
	helper.queue_free()
	hull.stop_all()
	hull.queue_free()
	await create_timer(0.5).timeout
	print("PASS production reviewed kill/short-minor clear: durations, calibration, grouping, dedup, guardian/ending priority, sliders/control routing, mute/solo/user mix/patch, cancellation, natural completion and no bank/master/save mutations")
	quit(0)
